PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change_me
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
PGSSL=false

# AWS for S3 uploads (snapshots + recordings)
# Use either IAM environment variables here OR a local ~/.aws/credentials profile.
# If using env vars, uncomment the next two lines and paste your keys (backend only).
# AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
S3_BUCKET=my-proctor-evidence
PRESIGN_TTL_SECONDS=120

# Admin auth for /auth/adminLogin (dev only)
ADMIN_SHARED_SECRET=changeme
